{
  "name": "@cap.core/ql",
  "version": "2.1.7",
  "description": "Minimalistic implementation of cds.ql, carved out from CAP.",
  "repository": "https://github.com/cap-js/ql.git",
  "author": "daniel.hutzel@sap.com",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cql/parser.min.js",
    "@types"
  ],
  "dependencies": {
    "@types/cap.core__ql": "file:./@types"
  },
  "scripts": {
    "peggy": "npx peggy cql/grammar.pegjs -o cql/parser.js --format es --allowed-start-rules CQL,subject,columns,values,ref,val,expr,set,with,where,groupBy,orderBy",
    "terser": "npx terser cql/parser.js -o cql/parser.min.js --compress --mangle --ecma 2022 --source-map",
    "build": "npm run peggy && npm run terser",
    "test": "npx vitest run"
  },
  "license": "Apache-2.0"
}