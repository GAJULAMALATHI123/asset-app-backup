// Grants the CAP role `cds.ExtensionDeveloper` (required for `cds push`/`pull`).
// Assign the resulting `ExtensionDeveloper` policy to users/groups in the AMS cockpit.
// Names are quoted because `cds.ExtensionDeveloper` contains a dot (a DCL token).
POLICY "ExtensionDeveloper" {
	ASSIGN ROLE "cds.ExtensionDeveloper";
}
