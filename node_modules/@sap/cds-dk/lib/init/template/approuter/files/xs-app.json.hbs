{
  {{#hasPortal}}
  "welcomeFile": "/cp.portal",
  {{/hasPortal}}
  {{#hasHtml5Repo}}
  "authenticationMethod": "route",
  {{/hasHtml5Repo}}
  "routes": [
    {{#hasMTXRoute}}
    {
      "source": "^/-/cds/.*",
      "destination": "mtx-api",
      "authenticationType": "none"
    },
    {{/hasMTXRoute}}
    {{#hasMTXRouteJava}}
    {
      "source": "^/mt/.*",
      "destination": "srv-api",
      "authenticationType": "none"
    },
    {{/hasMTXRouteJava}}
    {{#hasHtml5Repo}}
    {
      "source": "^/?odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      {{^hasIas}}{{#hasXsuaa}}"authenticationType": "xsuaa",{{/hasXsuaa}}{{/hasIas}}
      {{#hasIas}}"authenticationType": "ias",{{/hasIas}}
      "csrfProtection": true
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt"{{^hasIas}}{{#hasXsuaa}},
      "authenticationType": "xsuaa"{{/hasXsuaa}}{{/hasIas}}{{#hasIas}},
      "authenticationType": "ias"{{/hasIas}}
    }
    {{/hasHtml5Repo}}
    {{^hasHtml5Repo}}
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "csrfProtection": true
    }
    {{/hasHtml5Repo}}
  ]
}
