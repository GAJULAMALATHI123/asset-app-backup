{
  "welcomeFile": "/role-landing.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/user-api/(.*)$",
      "target": "/$1",
      "service": "sap-approuter-userapi",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/role-landing\\.html$",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/adminasset/(.*)$",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.Admin"
    },
    {
      "source": "^/manager-dashboard/(.*)$",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.Manager"
    },
    {
      "source": "^/user-dashboard/(.*)$",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.User"
    },
    {
      "source": "^/login/(.*)$",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    }
  ]
}
